# ==========================================
# ShowSpot - Event Ticket Booking Environment
# ==========================================

# Application Secrets
SECRET_KEY=dev-secret-key-showspot-2026-supersecure

# Database Configuration (MySQL / PyMySQL or SQLite fallback)
# MySQL Example: mysql+pymysql://root:password@localhost:3306/event_ticket_booking
DATABASE_URL=sqlite:///event_ticket_booking.db

# Admin Development Credentials
ADMIN_EMAIL=admin1234@gmail.com
ADMIN_PASSWORD=admin@1234

# Mail / SMTP Configuration (Console logger fallback enabled if credentials empty)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="ShowSpot Tickets <noreply@showspot.com>"

# Booking & Security Policies
MAX_SEATS_PER_BOOKING=10
SEAT_LOCK_DURATION_SECONDS=300
OTP_EXPIRY_SECONDS=300
CONVENIENCE_FEE_PERCENTAGE=5.0
TAX_PERCENTAGE=18.0
